---
import activitiesData from '../data/activities.json';
import { getLang, localizePath, pick, useTranslations } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// 中文页：中文名为主标题、英文名为副标题；英文页反过来
const activities = activitiesData.map(raw => {
  const a = pick(raw, lang);
  return {
    ...a,
    title: lang === 'en' ? a.enTitle : a.cnTitle,
    subtitle: lang === 'en' ? a.cnTitle : a.enTitle,
    link: localizePath(`/activities/${a.slug}`, lang),
  };
});

const specialEvents = [
  {
    href: '/activities/tabbit-nantong',
    image: '/images/activities/tabbit/12.jpg',
    date: '2026.6.14',
    subtitle: 'AI Skill Workshop',
    zh: {
      title: '美团 Tabbit 高校妙招大赛@南通大学',
      desc: 'DeepLearner联合美团Tabbit举办高校妙招大赛，同学们用Tabbit浏览器搭建专属AI工作流，经历现场创作与妙招路演，共有8件作品获奖。',
    },
    en: {
      title: 'Meituan Tabbit Campus Skill Contest @ Nantong University',
      desc: 'DeepLearner teamed up with Meituan’s Tabbit to host a campus Skill contest. Students used the Tabbit browser to build their own AI workflows, created live on site and pitched their Skills on stage, and 8 entries won awards.',
    },
  },
  {
    href: '/activities/special-event',
    image: '/images/activities/trae/1.jpg',
    date: '2026.5.16',
    subtitle: 'AI Coding Hackathon',
    zh: {
      title: 'TRAE on Campus @南通大学',
      desc: 'DeepLearner联合字节跳动TRAE举办AI Coding Hackathon，涵盖技术分享、闪电开发与项目路演，吸引了近百位同学参与。',
    },
    en: {
      title: 'TRAE on Campus @ Nantong University',
      desc: 'DeepLearner partnered with ByteDance’s TRAE to host an AI Coding Hackathon featuring tech talks, a lightning build sprint and project demos, drawing nearly 100 students.',
    },
  },
].map(e => ({ ...e, ...e[lang], href: localizePath(e.href, lang) }));
---

<section id="activities" class="w-full bg-black border-t-2 border-white/10 overflow-hidden">
  <div class="max-w-7xl mx-auto px-8 lg:px-12 py-24 md:py-36">
    
    <!-- Header -->
    <div class="flex flex-col items-center text-center justify-center gsap-fade-up mb-16">
      <span class="text-white/40 font-mono tracking-[0.2em] text-sm uppercase mb-4 block">
        [ 02 — Activities ]
      </span>
      <h2 class="font-display text-4xl sm:text-5xl font-semibold text-white uppercase tracking-tight">
        {t('activities.heading')}
      </h2>
    </div>

    <!-- Bento Grid: 1 featured + 3 smaller -->
    <div class="border border-white/10 gsap-stagger-container">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        
        <!-- Featured Card (Left, tall) -->
        <a 
          href={activities[0].link}
          class="activity-card block relative overflow-hidden lg:border-r border-white/10 gsap-stagger-item group"
        >
          <!-- Full image background -->
          <div class="aspect-[4/3] lg:aspect-auto lg:h-full w-full overflow-hidden relative">
            <div class="black-overlay absolute inset-0 bg-black/40 z-10"></div>
            <div class="absolute inset-0 bg-gray-900 flex items-center justify-center font-mono text-white/30 text-xs">IMG</div>
            <img loading="lazy" decoding="async" 
              src={activities[0].image} 
              alt={activities[0].title} 
              class="card-image w-full h-full object-cover relative z-0"
              onerror="this.style.display='none';"
            />
          </div>
          <!-- Overlay content -->
          <div class="absolute inset-x-0 bottom-0 h-[50%] bg-gradient-to-t from-black/90 to-transparent flex flex-col justify-end p-8 md:p-10 z-20">
            <h3 class="card-title font-display font-semibold text-2xl md:text-3xl text-white mb-1 text-shadow-md">
              {activities[0].title}
            </h3>
            <span class="font-mono text-xs tracking-widest text-gray-400 uppercase mb-3 block">
              {activities[0].subtitle}
            </span>
            <p class="card-desc font-sans text-sm text-gray-300 font-light leading-relaxed max-w-md">
              {activities[0].desc}
            </p>
          </div>
        </a>

        <!-- Right column: 3 smaller cards stacked -->
        <div class="grid grid-cols-1">
          {activities.slice(1).map((act, index) => (
            <a 
              href={act.link}
              class="activity-card flex items-start gap-6 p-6 md:p-8 border border-white/10 -mt-px gsap-stagger-item group hover:bg-white/[0.02] transition-colors"
            >
              <!-- Thumbnail -->
              <div class="w-28 md:w-36 shrink-0 aspect-[4/3] overflow-hidden border border-white/10 relative">
                <div class="black-overlay absolute inset-0 bg-black/30 z-10"></div>
                <img loading="lazy" decoding="async" 
                  src={act.image} 
                  alt={act.title} 
                  class="card-image w-full h-full object-cover"
                  onerror="this.style.display='none';"
                />
              </div>
              <!-- Text -->
              <div class="flex-1 min-w-0">
                <h3 class="card-title font-display font-semibold text-lg md:text-xl text-white mb-1 truncate">
                  {act.title}
                </h3>
                <span class="font-mono text-xs tracking-widest text-gray-500 uppercase mb-3 block">
                  {act.subtitle}
                </span>
                <p class="card-desc font-sans text-sm text-gray-400 font-light leading-relaxed line-clamp-2">
                  {act.desc}
                </p>
              </div>
              <!-- Arrow -->
              <div class="card-arrow shrink-0 w-8 h-8 rounded-full border border-white/20 flex items-center justify-center text-white self-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </a>
          ))}
        </div>

      </div>
    </div>

    <!-- Special Event Cards -->
    {specialEvents.map((event, i) => (
      <div class={`gsap-stagger-container ${i === 0 ? 'mt-8' : 'mt-6'}`}>
        <a 
          href={event.href}
          class="activity-card block border border-white/10 gsap-stagger-item group"
        >
          <div class="flex flex-col md:flex-row">
            <!-- Image -->
            <div class="md:w-1/3 aspect-[16/9] md:aspect-auto overflow-hidden relative">
              <div class="black-overlay absolute inset-0 bg-black/30 z-10"></div>
              <img loading="lazy" decoding="async" 
                src={event.image} 
                alt={event.title} 
                class="card-image w-full h-full object-cover"
                onerror="this.style.display='none';"
              />
            </div>
            <!-- Content -->
            <div class="flex-1 p-8 md:p-12 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-4">
                <span class="font-mono text-[10px] tracking-widest uppercase px-3 py-1 border border-blue-400/30 text-blue-400 bg-blue-400/10 backdrop-blur-sm">
                  Special Event
                </span>
                <span class="font-mono text-xs text-gray-500">{event.date}</span>
              </div>
              <h3 class="card-title font-display font-semibold text-2xl md:text-3xl text-white mb-2 group-hover:text-blue-400 transition-colors">
                {event.title}
              </h3>
              <span class="font-mono text-sm tracking-widest text-gray-500 uppercase mb-4 block">
                {event.subtitle}
              </span>
              <p class="card-desc font-sans text-base text-gray-400 font-light leading-relaxed max-w-2xl mb-6">
                {event.desc}
              </p>
              <div class="flex items-center gap-2 font-mono text-sm text-white/60 group-hover:text-white transition-colors">
                <span>{t('common.viewDetails')}</span>
                <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>
          </div>
        </a>
      </div>
    ))}

  </div>
</section>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll('.activity-card');

    cards.forEach(card => {
      const image = card.querySelector('.card-image');
      const overlay = card.querySelector('.black-overlay');
      const title = card.querySelector('.card-title');
      const desc = card.querySelector('.card-desc');
      const arrow = card.querySelector('.card-arrow');

      card.addEventListener('mouseenter', () => {
        gsap.to(card, { borderColor: 'rgba(255,255,255,0.3)', duration: 0.3, ease: 'power3.out' });
        if(image) gsap.to(image, { scale: 1.05, duration: 0.5, ease: 'power2.out' });
        if(overlay) gsap.to(overlay, { backgroundColor: 'transparent', duration: 0.4 });
        if(title) gsap.to(title, { color: '#60a5fa', duration: 0.3 });
        if(desc) gsap.to(desc, { color: '#d1d5db', duration: 0.3 });
        if(arrow) gsap.to(arrow, { backgroundColor: '#ffffff', color: '#000000', duration: 0.3 });
      });

      card.addEventListener('mouseleave', () => {
        gsap.to(card, { borderColor: 'rgba(255,255,255,0.1)', duration: 0.3, ease: 'power3.out' });
        if(image) gsap.to(image, { scale: 1, duration: 0.5, ease: 'power2.out' });
        if(overlay) gsap.to(overlay, { backgroundColor: 'rgba(0,0,0,0.4)', duration: 0.4 });
        if(title) gsap.to(title, { color: '#ffffff', duration: 0.3 });
        if(desc) gsap.to(desc, { color: '#9ca3af', duration: 0.3 });
        if(arrow) gsap.to(arrow, { backgroundColor: 'transparent', color: '#ffffff', duration: 0.3 });
      });
    });
  });
</script>
